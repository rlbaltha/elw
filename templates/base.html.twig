<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" href="https://brand.uga.edu/wp-content/uploads/cropped-favicon-144x144-1-192x192.png"
          sizes="192x192"/>
    <link rel="apple-touch-icon" href="https://brand.uga.edu/wp-content/uploads/cropped-favicon-144x144-1-180x180.png"/>
    <meta name="msapplication-TileImage"
          content="https://brand.uga.edu/wp-content/uploads/cropped-favicon-144x144-1-270x270.png"/>
    {% block stylesheets %}
        <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet">
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
              crossorigin="anonymous">
        <link type="text/css" rel="stylesheet" href="{{ asset('css/localv2.css') }}">
    {% endblock %}
    <title>{% block title %}eLW - University of Georgia{% endblock %}</title>
</head>

<body class="{% if is_granted('IS_AUTHENTICATED_FULLY') %}{% if app.user.theme != 'dark' %}light{% else %}dark{% endif %}{% endif %}">

{% block nav %}
    <nav class="navbar navbar-expand-lg navbar-light bg-light" aria-label="Main Navigation">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavMain"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a href="{{ path('course_index') }}" class="navbar-brand">
                <span class='navbar-brand'>eLW @ </span>
                <img src="https://brand.uga.edu/wp-content/uploads/GEORGIA-WRD-FC-768x192.png" height="25"
                     alt="UGA logo">
            </a>
            <div class="collapse navbar-collapse" id="navbarNavMain">
                <ul class="navbar-nav">
                    <li class="nav-item skip-link">
                        <a class="nav-link" href="#main-content">Skip to content</a>
                    </li>
                    {% block subnav %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                                   data-bs-toggle="dropdown"
                                   aria-haspopup="true" aria-expanded="false">
                                    Admin
                                </a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item" href="{{ path('user_index') }}">Users</a>
                                    <a class="dropdown-item" href="{{ path('course_admin') }}">Courses</a>
                                    <a class="dropdown-item" href="{{ path('markupset_index') }}">Markup Sets</a>
                                    <a class="dropdown-item" href="{{ path('rubric_index') }}">Rubrics</a>
                                    <a class="dropdown-item" href="{{ path('stage_index') }}">Stages</a>
                                    <a class="dropdown-item" href="{{ path('term_index') }}">Term</a>
                                    <a class="dropdown-item" href="{{ path('card_index') }}">Cards</a>
                                    <a class="dropdown-item" href="{{ path('data') }}">Data</a>
                                </div>
                            </li>
                        {% endif %}
                        {% if is_granted('IS_IMPERSONATOR') %}
                            <li class="nav-item">
                                <a class="nav-link"
                                   href="{{ path('course_index',{'status':'default'}) }}?_switch_user=_exit">
                                    Exit login as</a>
                            </li>
                        {% endif %}
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('course_index',{'status':'default'}) }}">Courses</a>
                            </li>
                        {% endif %}
                        {% if is_granted('ROLE_INSTRUCTOR') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('stage_index') }}">Stages</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('markupset_byuser') }}">Markup</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('rubric_index') }}">Rubrics</a>
                            </li>
                        {% endif %}
                    {% endblock %}
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% block subnavright %}
                        <li class="nav-item">
                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                            {% endif %}
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">Version 5.4</span>
                        </li>
                    {% endblock %}
                </ul>
            </div>
        </div>
    </nav>
{% endblock %}

{% block toolnav %}{% endblock %}
<div id="main-content" class="container-fluid pt-3 bg-light">
    {% for message in app.flashes('notice') %}
        <div aria-live="assertive" role="status" class="flash-messages alert alert-success">
            {{ message|raw }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div aria-live="assertive" role="status" class="flash-messages alert alert-danger">
            {{ message|raw }}
        </div>
    {% endfor %}
    {% block body %}{% endblock %}
</div>

</body>

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-4.0.0.js"
            integrity="sha256-9fsHeVnKBvqh3FB2HYu7g2xseAZ5MlN6Kz/qnkASV8U=" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.js"
            integrity="sha256-zKbi8I2J5A9/AtXEXqfqZN23Mt1wpVcyEDYCF/PSYKw=" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/@popperjs/core@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script src="{{ asset('js/sessiontimeout.js') }}">

{% block timeout %}
    <script type="module" src="{{ asset('js/sessiontimeout.js') }}">

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        import sessionTimeout from "{{ asset('js/sessiontimeout.js') }}";

        sessionTimeout({
            continueText: "Continue Session",
            logoutText: "Log Out",
            message: "Your session is about to expire.",
            timeoutAt: 20 * 60 * 1000, // Call onTimeout after 20 minutes
            warnAt: 15 * 60 * 1000, // Show warning after 15 minutes
        });
        {% endif %}
    </script>
{% endblock %}
{% endblock %}


</html>

{% extends 'base.html.twig' %}

{% block title %}Markup New - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('css/colorPick.css') }}">
    <style>
        button {
            margin-top: 2em;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <h3 class="card-title">New Markup</h3>
            {{ include('markup/_form.html.twig') }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('tinymce/tinymce.min.js') }}"></script>
    <script>
        tinymce.init({
            selector: '#markup_description',
            promotion: false,
            license_key: 'gpl',
            onboarding: false,
            menubar: false,
            content_css: '{{ asset('css/editor_document_v2.css')}}',
            // content_style: 'span.note { color:blue; background-color:white; border: #bababa solid 1px; border-radius: 10%;padding:4px; } span.highlight {background-color: hsl(60, 97%, 73%);}',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | bold italic  strikethrough |  numlist bullist  | link forecolor backcolor | removeformat',
            setup: function(editor) {
            }
        });
    </script>
    <script src="{{ asset('js/colorPick.js') }}"></script>
    {#    These colors must be replicated in the ckeditor_document_vx.css#}
    <script>
        $(document).ready(function () {
            $("#markup_color").colorPick({
                'initialColor': 'darkblue',
                'palette':['darkblue', 'rebeccapurple', 'darkred', 'darkgreen', 'midnightblue', 'darkolivegreen', 'black', 'teal', 'darkmagenta', 'saddlebrown', 'blue', 'crimson'],
                'onColorSelected': function () {
                    this.element.css({'backgroundColor': this.color, 'color': 'white'});
                    var selectedColor = this.color;
                    selectedColor = selectedColor.toLowerCase();
                    this.element.val(selectedColor);
                }
            });
        });
    </script>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}New Card{% endblock %}

{% block body %}
    <h1>Create new Card</h1>

    {{ include('card/_form.html.twig') }}

    <a href="{{ path('card_index') }}">back to list</a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('tinymce/tinymce.min.js') }}"></script>
    <script>
        tinymce.init({
            selector: 'card_body',
            promotion: false,
            license_key: 'gpl',
            onboarding: false,
            menubar: false,
            content_css: '{{ asset('css/editor_document_v2.css')}}',
            // content_style: 'span.note { color:blue; background-color:white; border: #bababa solid 1px; border-radius: 10%;padding:4px; } span.highlight {background-color: hsl(60, 97%, 73%);}',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | bold italic  strikethrough |  numlist bullist  | link forecolor backcolor | removeformat',
            setup: function(editor) {
            }
        });
    </script>
{% endblock %}

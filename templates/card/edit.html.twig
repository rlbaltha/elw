{% extends 'base.html.twig' %}

{% block title %}Edit Card{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('css/ckeditor_document_v2.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('style.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('ckeditor5/ckeditor5.css')}}">
{% endblock %}

{% block body %}
    <h1>Edit Card</h1>

    {{ include('card/_form.html.twig', {'button_label': 'Update'}) }}


    {{ include('card/_delete_form.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('tinymce/tinymce.min.js') }}"></script>
    <script>
        tinymce.init({
            selector: '#card_body',
            promotion: false,
            license_key: 'gpl',
            onboarding: false,
            menubar: false,
            content_css: '{{ asset('css/ckeditor_document_v2.css')}}',
            // content_style: 'span.note { color:blue; background-color:white; border: #bababa solid 1px; border-radius: 10%;padding:4px; } span.highlight {background-color: hsl(60, 97%, 73%);}',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount', 'help'
            ],
            toolbar: 'undo redo | bold italic  strikethrough |  numlist bullist  | link forecolor backcolor | removeformat | help',
            setup: function(editor) {
            }
        });
    </script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Journal Edit - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('css/ckeditor_document_v2.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('style.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('ckeditor5/ckeditor5.css')}}">

    <style>
        .editor-container__editor {
            min-width: 100% !important;
        }
        .ck-editor__editable {
            min-height: 60vh;
            max-height: 60vh;
        }

    </style>
{% endblock %}

{% block subnav %}
    <li class="navbar-brand">{{ doc.title }}</li>
    <li class="nav-item">
        <a href="#" id="submit-doc-form" class="btn btn-primary">Save</a>
    </li>
{% endblock %}

{% block subnavright %}
    <li class="nav-item">
        <a id='saving_alert' href="javascript:void(0);" class="nav-link" id="doc_save">Saving</a>
    </li>
    <li class="nav-item">
        {% if doc.comments|length == 0 and doc.agsResultId is null %}
            <a id="delete-trigger" class="nav-link" href="#">Delete</a>
            {{ include('journal/_delete_form.html.twig') }}
        {% else %}
            <p class="navbar-text">Journal entries that have end comments or grades cannot be deleted.</p>
        {% endif %}
    </li>
{% endblock %}


{% block body %}
    <div class="row">
        <div class="col">
            <span class="navbar-brand">{{ doc.title }}</span>
            {# Word Count #}
            <div class="card mb-3">
                <div class="card-header">Document Statistics</div>
                <div class="card-body">
                    <div><span>Word Count: </span><span id="word-count">{{ doc.wordcount }}</span></div>
                    <div><span> Document status: </span><span  id="editor-status">Unchanged</span></div>
                </div>

            </div>

            <div id="save_error" class="alert alert-danger d-none">The autosave failed. Please copy your current work before
                closing and return to eLC to login again.
            </div>
            {{ include('doc/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script type="importmap">
        {
            "imports": {
                "ckeditor5": "{{ asset('ckeditor5/ckeditor5.js') }}",
				"ckeditor5/": "./ckeditor5/"
			}
		}
    </script>
    <script type="module" src="{{ asset('js/journal_editor_init.js') }}"></script>


    <script>
        $(document).ready(function () {
            function submitdocform() {
                var body = editor.getData();
                var count = countWords(body);
                $('#journal_wordcount').val(count);
                $("#doc-form").submit(); // Submit the form
            };


            $("#submit-doc-form").click(function () {
                submitdocform()
            });

            {# Delete doc trigger #}
            $('#delete-trigger').click(function () {
                $("#delete-form").submit();
            });

            $('#saving_alert').hide();
            var autoSave = setInterval(function () {
                var buffer = $('#editor-status').text();
                if (buffer == 'Changed') {
                    var body = editor.getData();
                    var count = countWords(body);
                    $('#journal_wordcount').val(count);
                    $.post("{{ course_path('doc_autosave', { 'id': doc.id }) }}", {
                        docBody: body,
                        count: count
                    }, function (data) {
                    })
                        .fail(function() {
                            $('#save_error').removeClass("d-none");
                        });
                    ;
                    $('#editor-status').text('changes saved');
                    $('#word-count').text(count);
                    $('#saving_alert').fadeIn();
                    $('#saving_alert').delay(3000).fadeOut();

                }
            }, 15000);

            // A simple (but potentially imperfect) way to strip HTML tags and count
            function countWords(body) {
                var countP = countPElementsInString(body);
                // Create a temporary div element to leverage the browser's DOM parsing
                const div = document.createElement("div");
                div.innerHTML = body;
                const textOnly = div.textContent || div.innerText || "";
                // Count words (basic split by whitespace)
                const wordsArray = textOnly.trim().split(/\s+/);
                const countW = (wordsArray.length === 1 && wordsArray[0] === "") ? 0 : wordsArray.length;
                const wordCount = countP + countW -1;
                return wordCount;
            }

            function countPElementsInString(body) {
                // Create a new DOMParser instance
                const parser = new DOMParser();
                // Parse the HTML string into a Document object
                const doc = parser.parseFromString(body, 'text/html');
                // Select all 'p' elements within the parsed document
                const paragraphs = doc.querySelectorAll('p');
                // Return the number of found 'p' elements
                return paragraphs.length;
            }

            // Accessibility speedkeys for doc editing
            // function to set speedkey Alt+S for submitting a doc
            document.addEventListener('keydown', function(event) {
                const isModifier = navigator.platform.match("Mac") ? event.metaKey : event.altKey;
                const isKey = event.key === 's' || event.key === 's';
                if (isModifier && isKey) {
                    event.preventDefault(); // Prevent default browser actions (e.g., bookmarking)
                    submitdocform();
                }
            });

        });
    </script>

{% endblock %}
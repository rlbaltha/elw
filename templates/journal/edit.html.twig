{% extends 'base.html.twig' %}

{% block title %}Journal Edit - {{ doc.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('style.css')}}">
    <style>
        .editor-container__editor {
            min-width: 100% !important;
        }
    </style>
{% endblock %}

{% block subnav %}
    <li class="navbar-brand">{{ doc.title }}</li>
    <li class="nav-item">
        <a href="#" id="submit-doc-form" class="btn btn-primary">Save</a>
    </li>
{% endblock %}

{% block subnavright %}
    <li class="nav-item">
        <a id='saving_alert' href="javascript:void(0);" class="nav-link" id="doc_save">Saving</a>
    </li>
    <li class="nav-item">
        {% if doc.comments|length == 0 and doc.agsResultId is null %}
            <a id="delete-trigger" class="nav-link" href="#">Delete</a>
            {{ include('journal/_delete_form.html.twig') }}
        {% else %}
            <p class="navbar-text">Journal entries that have end comments or grades cannot be deleted.</p>
        {% endif %}
    </li>
{% endblock %}


{% block body %}
    <div class="row">
        <div class="col">
            <span class="navbar-brand">{{ doc.title }}</span>
            {# Word Count #}
            <div class="card mb-3">
                <div class="card-header">Document Statistics</div>
                <div class="card-body">
                    <div><span>Word Count: </span><span id="word-count">{{ doc.wordcount }}</span></div>
                    <div><span> Document status: </span><span  id="editor-status">unchanged</span></div>
                </div>

            </div>

            <div id="save_error" class="alert alert-danger d-none">The autosave failed. Please copy your current work before
                closing and return to eLC to login again.
            </div>
            {{ include('doc/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('tinymce/tinymce.min.js') }}"></script>
    <script>
        tinymce.init({
            selector: '#journal_body',
            promotion: false,
            license_key: 'gpl',
            height: 800,
            onboarding: false,
            content_css: '{{ asset('css/editor_document_v2.css')}}',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount', 'image', 'help'
            ],
            menubar: 'file edit view insert format table help',
            removed_menuitems: 'newdocument pastetext codesample anchor codeformat ',
            toolbar: 'undo redo | fontfamily fontsize styles | bold italic forecolor backcolor underline strikethrough | link image media table  |  align lineheight | checklist numlist bullist indent outdent |  removeformat | help',
            style_formats: [
                { title: 'Styles', items: [
                        { title: 'Paragraph', format: 'p' },
                        { title: 'Hanging Indent', block: 'p', classes: 'doc_hanging_indent' },
                        { title: 'Blockquote', format: 'blockquote' },
                        { title: 'Heading 1', format: 'h1' },
                        { title: 'Heading 2', format: 'h2' },
                        { title: 'Heading 3', format: 'h3' },
                        { title: 'Heading 4', format: 'h4' },
                    ]},
                { title: 'Format', items: [
                        { title: 'Bold', format: 'bold' },
                        { title: 'Italic', format: 'italic' },
                        { title: 'Underline', format: 'underline' },
                        { title: 'Strikethrough', format: 'strikethrough' },
                        { title: 'Superscript', format: 'superscript' },
                        { title: 'Subscript', format: 'subscript' },
                    ]},
                { title: 'Align', items: [
                        { title: 'Left', format: 'alignleft' },
                        { title: 'Center', format: 'aligncenter' },
                        { title: 'Right', format: 'alignright' },
                        { title: 'Justify', format: 'alignjustify' }
                    ]},
            ],
            setup: function(editor) {
                editor.on('init', function (e) {
                    var wordCount = editor.plugins.wordcount.getCount();
                    const wordCountWrapper = document.getElementById('word-count');
                    wordCountWrapper.innerText = wordCount;
                });
                editor.addShortcut('alt+shift+y', 'Add yellow highlight to selected text.', () => {
                    editor.execCommand('hilitecolor', false , '#FFFF00');
                });
                editor.addShortcut('alt+shift+s', 'Save the Document', () => {
                    var editor = tinymce.activeEditor;
                    var wordCount = editor.plugins.wordcount.getCount();
                    $('#journal_wordcount').val(wordCount);
                    $("#doc-form").submit(); // Submit the form
                });
                editor.on('WordCountUpdate', function (e) {
                    var wordCount = editor.plugins.wordcount.getCount();
                    const wordCountWrapper = document.getElementById('word-count');
                    wordCountWrapper.innerText = wordCount;
                    if (editor.isDirty()) {
                        const editorStatus = document.getElementById('editor-status');
                        editorStatus.innerText = 'changed';
                    }
                });
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            function submitdocform() {
                // Get the active editor instance
                var editor = tinymce.activeEditor;
                // Access the word count
                var wordCount = editor.plugins.wordcount.getCount();
                $('#journal_wordcount').val(wordCount);
                $("#doc-form").submit(); // Submit the form
            }

            $("#submit-doc-form").click(function () {
                submitdocform()
            });

            {# Delete doc trigger #}
            $('#delete-trigger').click(function () {
                $("#delete-form").submit();
            });

            $('#saving_alert').hide();
            var autoSave = setInterval(function () {
                // Get the active editor instance
                var editor = tinymce.activeEditor;
                // Access the word count
                var wordCount = editor.plugins.wordcount.getCount();
                var buffer = $('#editor-status').text();
                if (tinymce.activeEditor.isDirty()) {
                    $('#journal_wordcount').val(wordCount);
                    var body = tinymce.activeEditor.getContent();
                    $.post("{{ course_path('doc_autosave', { 'id': doc.id }) }}", {
                        docBody: body,
                        count: wordCount
                    }, function (data) {
                    })
                        .fail(function () {
                            $('#save_error').removeClass("d-none");
                        });
                    ;
                    $('#editor-status').text('changes saved');

                    $('#saving_alert').fadeIn();
                    $('#saving_alert').delay(3000).fadeOut();

                }
            }, 15000);
        });
    </script>

{% endblock %}
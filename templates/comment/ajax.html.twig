{# twig template for ajax fragment #}

<div id="comment{{ doc.id }}">
    <link type="text/css" rel="stylesheet" href="{{ asset('css/ckeditor_document_v2.css') }}">
    <link type="text/css" rel="stylesheet" href="{{ asset('style.css') }}">
    <link type="text/css" rel="stylesheet" href="{{ asset('ckeditor5/ckeditor5.css') }}">

    <style>
        .editor-container__editor {
            min-width: 100% !important;
        }

        .ck-editor__editable {
            min-height: 30vh;
            max-height: 30vh;
        }

    </style>
    <div id="loading_alert" class="alert alert-info" style="display: none;">Loading</div>
    <hr/>
    {{ include('comment/_ajaxform.html.twig') }}

    <script>
        $('#comment_journal_body').tinymce({
            api_key: 'djv9sd5cglz5juyg74qpl35zvkwsgf1aj22n0cg9f57sq3nx',
            onboarding: false,
            menubar: false,
            content_css: '{{ asset('css/ckeditor_document_v2.css') }}',
            // content_style: 'span.note { color:blue; background-color:white; border: #bababa solid 1px; border-radius: 10%;padding:4px; } span.highlight {background-color: hsl(60, 97%, 73%);}',
            plugins: [
                // Core editing features
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | bold italic  strikethrough |  numlist bullist  | link forecolor backcolor | removeformat',
            setup: function (editor) {
            }
        });

        $('.ajax_submit').click(function(e) {
            tinyMCE.triggerSave();
            let formData = $('[name="comment_journal"]').serialize();
            //Perform the AJAX request
            $.ajax({
                type: 'POST',
                url: '{{ request_url }}', // Replace with your server endpoint
                data: formData,
                });
                tinymce.remove(tinymce.activeEditor);

                setTimeout(
                function () {
                    var request = "{{ path('comment_ajax_show', {'courseid': doc.course.id, 'docid': doc.id}) }}";
                    var target = "#comment{{ doc.id }}"
                    $.ajax({
                        url: request, success: function (result) {
                            $(target).replaceWith(result);
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            if (xhr.status === 404) {
                                $(target).html('<p>Unable to load comment form.</p>');
                            }
                        }
                    });
                }, 500);
            });
    </script>

    <script>
        // cancel submit (hide form)
        $(".ajax_cancel").click(function (e) {
            setTimeout(
                function () {
                    var request = "{{ path('comment_ajax_show', {'courseid': doc.course.id, 'docid': doc.id}) }}";
                    var target = "#comment{{ doc.id }}"
                    $.ajax({
                        url: request, success: function (result) {
                            $(target).replaceWith(result);
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            if (xhr.status === 404) {
                                $(target).html('<p>Unable to load comment form.</p>');
                            }
                        }
                    });
                }, 500);
        });
    </script>

</div>

{% extends 'base.html.twig' %}

{% block title %}Course Edit - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('css/ckeditor_document_v2.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('style.css')}}">
    <link type="text/css" rel="stylesheet" href="{{ asset('ckeditor5/ckeditor5.css')}}">
{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <h1 class="card-title">{{ course.name }}</h1>
            {{ include('course/_form.html.twig', {'button_label': 'Update'}) }}

            <p class="alert alert-warning mt-3">Be sure to create your Projects after you have submitted your course information.</p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="importmap">
        {
            "imports": {
                "ckeditor5": "{{ asset('ckeditor5/ckeditor5.js') }}",
				"ckeditor5/": "./ckeditor5/"
			}
		}
    </script>
    <script type="module" src="{{ asset('js/announcement_editor_init.js') }}"></script>
{% endblock %}
